{
  "expo": {
    "name": "NutriTrack AI",
    "slug": "nutritrack-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NutriTrack AI needs microphone access to record your voice messages for logging meals and asking nutrition questions."
      }
    },
    "android": {},
    "web": {},
    "plugins": [
      "expo-status-bar"
    ]
  }
}
